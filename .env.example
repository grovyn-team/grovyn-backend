# MongoDB
MONGODB_URI=

# CORS (Next.js site origin, e.g. http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# Cloudinary (resumes + CMS images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix for signed CMS uploads from admin
CLOUDINARY_CMS_FOLDER=grovyn/cms

# Admin JWT (generate a long random string). Use double quotes if the value contains #.
ADMIN_JWT_SECRET=

# First admin only: set a long random secret, POST /admin/auth/bootstrap with
# { "email", "password", "setupSecret" }, then remove or rotate ADMIN_SETUP_SECRET.
# Quote the value if it contains # (otherwise dotenv treats # as start of a comment).
ADMIN_SETUP_SECRET=

# Redis (OTP + short-lived reset/login state)
REDIS_URL=redis://localhost:6379

# Resend (admin login OTP + password reset emails)
RESEND_API_KEY=
# Optional; defaults to Grovyn <onboarding@resend.dev> for Resend trials
EMAIL_FROM=

# Optional; link in “admin invite” emails. Falls back to FRONTEND_URL + /admin/login
# DASHBOARD_LOGIN_URL=https://your-domain.com/admin/login

# Server
PORT=8080
